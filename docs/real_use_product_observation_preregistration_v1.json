{
  "schema_version": "omc-real-use-observation-preregistration/v1",
  "study_id": "real-use-product-observation-202609-v1",
  "created_at": "2026-08-31T13:00:20+09:00",
  "observation_window": {
    "starts_at": "2026-09-01T00:00:00+09:00",
    "ends_at": "2026-09-14T23:59:59+09:00",
    "automatic_extension_allowed": false
  },
  "repositories": [
    "sixshop3-storefront-fe",
    "market-reasoning-engine",
    "research-auto"
  ],
  "eligibility": {
    "candidate_population": "every naturally occurring task in the fixed repositories during the observation window",
    "candidate_capture_policy": "prospective_chronological_first_n",
    "candidate_universe_source": "complete_session_start_receipt_inventory",
    "candidate_universe_rule": "every session_start receipt in a fixed repository during the observation window must map to exactly one candidate event, including excluded tasks",
    "completeness_reconciliation_required": true,
    "record_every_candidate": true,
    "selection_count": 6,
    "observed_at_source": "session_start_receipt.recorded_at",
    "selection_tie_breaker": "candidate_event_id_ascending",
    "replacement_allowed": false,
    "eligibility_decision_values": [
      "eligible",
      "excluded"
    ],
    "exclusion_reason_policy": "null for eligible; non-empty string for excluded",
    "required_candidate_event_fields": [
      "candidate_event_id",
      "observed_at",
      "repository",
      "request_sha256",
      "eligibility_decision",
      "exclusion_reason"
    ],
    "required_task_kinds": [
      "implementation",
      "bug_fix",
      "refactoring"
    ],
    "requires_verifiable_definition_of_done": true,
    "complexity_any_of": [
      "changes_at_least_3_files",
      "adds_or_changes_api",
      "crosses_multiple_dependencies",
      "estimated_duration_at_least_30_minutes"
    ],
    "excluded_task_kinds": [
      "documentation",
      "setup",
      "roadmap",
      "benchmark_maintenance",
      "synthetic_fixture",
      "completed_task_replay"
    ],
    "must_be_recorded_before_task_execution": true
  },
  "source_freeze": {
    "omc_kit_commit": "3dc2dc45e0752b94c2c017d2cc87bc17e359db84",
    "receipt_required_before_eligibility": true,
    "required_receipt_fields": [
      "repository",
      "omc_source_commit",
      "install_manifest_sha256",
      "strict_audit_status",
      "recorded_at"
    ],
    "required_strict_audit_status": "pass",
    "source_change_policy": "close_current_study_and_preregister_new_study"
  },
  "terminal_state_contract": {
    "exactly_one_required": true,
    "states": {
      "VERIFIED_COMPLETION": "OMC completed the task and every preregistered verification command passed without manual implementation takeover.",
      "MANUAL_TAKEOVER": "The user or another agent took over implementation before all preregistered verification commands passed.",
      "ABANDONED": "The task ended without verified completion and without a completed manual takeover."
    }
  },
  "metrics": {
    "eligible_tasks": {
      "required_count": 6,
      "minimum_repositories": 2
    },
    "verified_completion": {
      "numerator": "count(terminal_state == VERIFIED_COMPLETION)",
      "denominator": "eligible_tasks",
      "minimum_count": 5
    },
    "manual_takeover": {
      "numerator": "count(terminal_state == MANUAL_TAKEOVER)",
      "denominator": "eligible_tasks",
      "maximum_count": 1
    },
    "abandonment": {
      "numerator": "count(terminal_state == ABANDONED)",
      "denominator": "eligible_tasks",
      "maximum_count": 0
    },
    "confirmation": {
      "per_task_value": "count of explicit user confirmation prompts after eligibility recording and before terminal state, including zero",
      "population": "all eligible_tasks",
      "median_method": "arithmetic_mean_of_two_middle_values_for_even_population",
      "maximum_median": 2
    },
    "repeat_use": {
      "definition": "repository with at least minimum_tasks_per_repository eligible tasks",
      "minimum_repositories": 2,
      "minimum_tasks_per_repository": 2
    }
  },
  "missing_data_policy": {
    "validation_scope": "required_fields_for_each_event_type",
    "outcome": "OBSERVATION_INCONCLUSIVE",
    "imputation_allowed": false
  },
  "ledger": {
    "path": ".omc/observations/real-use-product-observation-202609-v1.jsonl",
    "mutation_policy": "append_only",
    "correction_policy": "append a new event with supersedes_event_id; never replace an existing event",
    "required_finalization": "append FINALIZATION with pre-finalization hash, then write detached finalization receipt for the complete ledger before adjudication",
    "required_every_event_fields": [
      "event_id",
      "study_id",
      "preregistration_sha256",
      "registration_git_commit"
    ],
    "pre_finalization_hash_scope": "all complete JSONL event lines before FINALIZATION, including one LF byte after each line",
    "detached_finalization_receipt": {
      "path": ".omc/observations/real-use-product-observation-202609-v1.finalization-receipt.json",
      "mutation_policy": "write_once",
      "required_fields": [
        "study_id",
        "preregistration_sha256",
        "registration_git_commit",
        "finalization_event_sha256",
        "finalized_ledger_sha256",
        "source_receipt_sha256_by_repository",
        "recorded_at"
      ],
      "finalization_event_hash_scope": "the complete FINALIZATION JSONL line, including one trailing LF byte",
      "finalized_ledger_hash_scope": "the complete ledger after FINALIZATION, including one LF byte after the FINALIZATION line"
    },
    "event_types": {
      "CANDIDATE_OBSERVED": {
        "required_fields": [
          "candidate_event_id",
          "observed_at",
          "eligibility_recorded_at",
          "session_start_receipt_sha256",
          "source_receipt_sha256",
          "repository",
          "request_sha256",
          "eligibility_decision",
          "exclusion_reason"
        ],
        "forbidden_fields": [
          "terminal_state",
          "verification_results",
          "confirmation_count"
        ]
      },
      "TASK_TERMINAL": {
        "required_fields": [
          "candidate_event_id",
          "session_id",
          "repository",
          "source_receipt_sha256",
          "omc_source_commit",
          "install_manifest_sha256",
          "verification_commands",
          "verification_results",
          "confirmation_count",
          "terminal_state"
        ],
        "requires_selected_candidate": true
      },
      "CORRECTION": {
        "required_fields": [
          "supersedes_event_id",
          "correction_reason"
        ],
        "source_binding": "inherit from the superseded event"
      },
      "FINALIZATION": {
        "required_fields": [
          "session_start_inventory_sha256_by_repository",
          "candidate_stream_sha256",
          "selected_candidate_event_ids",
          "session_start_count_by_repository",
          "candidate_event_count_by_repository",
          "source_receipt_sha256_by_repository",
          "pre_finalization_ledger_sha256",
          "completeness_attestation"
        ],
        "requires_candidate_stream_reconciliation": true
      }
    }
  },
  "binding_validation": {
    "event_preregistration_sha256_must_equal_registered_artifact_sha256": true,
    "event_registration_git_commit_must_equal_first_session_registration_commit": true,
    "task_terminal_candidate_event_id_must_reference_selected_candidate": true,
    "session_start_receipt_must_appear_exactly_once_in_candidate_stream": true
  },
  "outcome_order": [
    {
      "when": "candidate stream is incomplete, any required field is missing, or any registration or source receipt is invalid",
      "outcome": "OBSERVATION_INCONCLUSIVE"
    },
    {
      "when": "eligible_tasks < 6 at observation_window.end after candidate stream validation",
      "outcome": "LOW_NATURAL_DEMAND"
    },
    {
      "when": "any metric threshold is not satisfied",
      "outcome": "PRODUCT_WORKFLOW_NOT_READY"
    },
    {
      "when": "all metric thresholds are satisfied",
      "outcome": "OPERATIONAL_SAMPLE_READY"
    }
  ],
  "registration": {
    "artifact_path": "docs/real_use_product_observation_preregistration_v1.json",
    "must_be_committed_before_first_eligible_session": true,
    "first_session_must_record": [
      "registration_git_commit",
      "artifact_sha256"
    ],
    "every_event_must_record": [
      "study_id",
      "preregistration_sha256",
      "registration_git_commit"
    ]
  },
  "promotion_policy": {
    "automatic_product_value_promotion_allowed": false
  }
}
