    "blind_adjudication": true,
    "collection_window_days": 21,
    "selection_policy": "chronological_first_eligible_implementation_no_replacement",
    "minimum_repository_count": 2,
    "maximum_cases_per_repository": 7,
    "preregistration_proof": "Before case one, a study and reconciliation co-signed registration freezes T0, the 21-day deadline, a canonical origin plus root-commit repository roster, selection and repository-diversity policy, arm mapping hash, authority keys, and thresholds. Each case then carries a reconciliation-signed enrollment linked to the previous enrollment and a reopened state-evidence cursor interval proving that no earlier eligible implementation session was skipped. Registration and enrollment hashes are embedded before provider execution and revalidated at persona-decision.",
    "primary_metric": "human_additional_correction_instruction_rate",
    "secondary_metrics": [
      "completion_rate",
      "verification_pass_rate",
      "total_human_interventions",
      "rework_count",
      "end_to_end_wall_clock"
    ],
    "excluded_work_classes": [
      "synthetic",
      "document_only",
      "benchmark_maintenance"
    ]
  },
  "decision": {
    "minimum_relative_reduction": 0.3,
    "minimum_baseline_correction_events": 3,
    "correction_event_definition": "For one arm and case, true only when the human provides at least one post-implementation instruction requiring a code change to satisfy the frozen DoD or verification command; approvals, answers to pre-execution questions, and adoption decisions are excluded.",
    "correction_rate_denominator": "ten_paired_cases_per_arm",
    "correction_evidence_binding": "Each signed blind-adjudication v2 case entry uses anonymous arm_a and arm_b fields and binds both decisions to a root-relative regular-file descriptor. persona-decision reopens each file with O_NOFOLLOW and compares its SHA-256 before a signed arm mapping may reveal direct_codex and omc_persona. It also reopens all ten enrollment state intervals, verifies their append-only hash and cursor chain, and requires each terminal dry-run to carry the matching registration and enrollment hashes.",
    "completion_non_inferiority_required": true,
    "verification_non_inferiority_required": true,
    "total_human_intervention_non_inferiority_required": true,
    "median_wall_clock_noninferiority_ratio": 1.15,
