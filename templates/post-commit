#!/bin/sh
# OMC:POST_COMMIT:V1

status=0
original="$(dirname "$0")/post-commit.omc-original"
if [ -x "$original" ]; then
  "$original" "$@" || status=$?
fi

if [ -f scripts/omc.py ]; then
  python3 scripts/omc.py state decision-consume-current --target . ||
    printf '%s\n' '[OMC] local commit decision consumption failed' >&2
  python3 scripts/omc.py state complete --target . ||
    printf '%s\n' '[OMC] Git 커밋 성공, OMC 완료 기록 실패 — 위 오류를 확인하세요. 커밋을 다시 실행하지 마세요.' >&2
fi

exit "$status"
