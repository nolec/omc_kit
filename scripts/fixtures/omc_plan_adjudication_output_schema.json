{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMC Plan Pilot Indexed Blind Adjudication Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "items"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_index",
          "requirement_hit_indexes",
          "scope_violation_indexes",
          "task_requirement_links",
          "edge_requirement_links",
          "unsupported_assumption_indexes"
        ],
        "properties": {
          "item_index": {"type": "integer", "minimum": 0},
          "requirement_hit_indexes": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "scope_violation_indexes": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "task_requirement_links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["task_index", "requirement_indexes"],
              "properties": {
                "task_index": {"type": "integer", "minimum": 0},
                "requirement_indexes": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 0}
                }
              }
            }
          },
          "edge_requirement_links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edge_index",
                "before_requirement_indexes",
                "after_requirement_indexes"
              ],
              "properties": {
                "edge_index": {"type": "integer", "minimum": 0},
                "before_requirement_indexes": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 0}
                },
                "after_requirement_indexes": {
                  "type": "array",
                  "items": {"type": "integer", "minimum": 0}
                }
              }
            }
          },
          "unsupported_assumption_indexes": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
