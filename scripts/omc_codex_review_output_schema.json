{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "evidence", "findings"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REVISE", "BLOCK"]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary", "file", "line"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
